# Express Server Environment Configuration (Render / Local)
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas in Production, or local MongoDB in Dev)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/Parkinsons?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/parkinsons

# JWT Authentication Secret (MUST be a strong, unpredictable secret in production, min 32 characters)
JWT_SECRET=90f69c9463d1c3fbd853e33520fc2212c712ee1f1af00e80de3a798b8947efd94c89f651211cf115fe7c373f4028988da0a630ac15fc39c8acb5fe7dac252638

# Python ML Microservice URL on Render
PYTHON_SERVICE_URL=http://localhost:8000

# Frontend Origin for CORS (Vercel production domain)
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5000

# Optional: Transactional Email via Brevo REST API v3
BREVO_API_KEY=
EMAIL_FROM=no-reply@parkinson-research.org
EMAIL_FROM_NAME=Parkinson's Assessment Portal
